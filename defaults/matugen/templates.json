{
  "templates": [
    {
      "name": "gtk4",
      "input": "gtk-4.0/gtk.css",
      "output": "~/.local/state/quickshell/user/generated/gtk-4-rendered.css"
    },
    {
      "name": "gtk3",
      "input": "gtk-3.0/gtk.css",
      "output": "~/.local/state/quickshell/user/generated/gtk-3-rendered.css"
    },
    {
      "name": "kde_colors",
      "input": "kde/color.txt",
      "output": "~/.local/state/quickshell/user/generated/color.txt"
    },
    {
      "name": "wallpaper",
      "input": "wallpaper.txt",
      "output": "~/.local/state/quickshell/user/generated/wallpaper/path.txt"
    },
    {
      "name": "firefox_materialfox",
      "input": "firefox/materialfox.css",
      "output": "~/.local/state/quickshell/user/generated/firefox-materialfox.css"
    },
    {
      "name": "steam_millennium_material",
      "input": "steam/millennium-material.css",
      "output": "~/.local/state/quickshell/user/generated/steam-millennium-material.css"
    },
    {
      "name": "fcitx5-panel-svg",
      "input": "fcitx5/panel.svg",
      "output": "~/.local/share/fcitx5/themes/nyxmellow/panel.svg"
    },
    {
      "name": "fcitx5-highlight-svg",
      "input": "fcitx5/highlight.svg",
      "output": "~/.local/share/fcitx5/themes/nyxmellow/highlight.svg"
    },
    {
      "name": "fcitx5-theme-conf",
      "input": "fcitx5/theme.conf",
      "output": "~/.local/share/fcitx5/themes/nyxmellow/theme.conf"
    }
  ]
}
