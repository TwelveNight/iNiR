// Personal dialog rules; keep upstream 30-window-rules.kdl separate.
// Portal dialogs may lack a transient parent, so Niri cannot auto-float them.
window-rule {
    match app-id=r#"^xdg-desktop-portal-(gtk|gnome|kde)$"#
    match app-id=r#"^org\.freedesktop\.impl\.portal\.desktop\.(gtk|gnome|kde)$"#

    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 700; }
}
